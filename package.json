{
  "name": "aad",
  "version": "2.2.0",
  "private": true,
  "description": "AAD: Agent-Assisted Development. A working process for people and AI agents that share knowledge and tasks.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jveres/aad.git"
  },
  "homepage": "https://jveres.github.io/aad/",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p . && node scripts/build.js && node scripts/check-samples.js",
    "typecheck": "tsc -p . --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:version": "node scripts/check-version.js",
    "check": "npm run check:version && npm run lint && npm run typecheck",
    "serve": "npm run build && node scripts/serve.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "7.0.2"
  }
}
